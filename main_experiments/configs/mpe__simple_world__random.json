{
  "runtime": "mpe",
  "train": {
    "actor_lr": 2e-05,
    "alpha": 1.0,
    "anchor_coef": 0.01,
    "batch_size": 32,
    "clip": 0.05,
    "critic_lr": 0.0003,
    "data_root": "${DATA_ROOT}/mpe",
    "entropy_coef": 0.001,
    "epochs": 4,
    "gae_lambda": 0.95,
    "gamma": 0.99,
    "initial_std": 0.2,
    "log_every": 1000,
    "max_grad_norm": 0.5,
    "n_envs": 120,
    "obs_dim": 27,
    "output": "${OUTPUT_ROOT}/main/mpe__simple_world__random",
    "ppo_batch_size": 128,
    "ppo_eval_every": 250000,
    "ppo_steps": 50000000,
    "pretrain_discount": 0.995,
    "pretrain_eval_every": 50000,
    "pretrain_lr": 0.0003,
    "pretrain_steps": 1000000,
    "rollout_steps": 128,
    "seed": 0,
    "sequence_length": 20,
    "smoke": false,
    "split": "random",
    "target_kl": 0.02,
    "task": "simple_world",
    "tau": 0.005,
    "warmup_steps": 22,
    "workers": 4
  }
}
